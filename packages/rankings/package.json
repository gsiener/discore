{
  "name": "@scorebot/rankings",
  "version": "0.1.0",
  "description": "USAU-style iterative ratings, predictions and scenario math (HS adaptation)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "scale-check": "tsx scripts/scale-check.ts",
    "fixture-snapshot": "tsx scripts/make-fixture-snapshot.ts",
    "snapshots": "tsx scripts/make-snapshots.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
